    <!-- FAQ -->
    <string name="faq_q1">Hva er NEO Local LM?</string>
    <string name="faq_a1">NEO Local LM lar deg kjÃ¸re store sprÃ¥kmodeller direkte pÃ¥ Android-enheten din. All behandling skjer lokalt \u2013 ingen skytjenere nÃ¸dvendig.</string>
    <string name="faq_q2">Hvilke modeller stÃ¸ttes?</string>
